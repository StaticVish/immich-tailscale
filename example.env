#
# Immich + Tailscale + Caddy Environment Template
# Copy this file to .env and fill in your values:
#   cp example.env .env
#

# Primary library storage path on your host / NAS (where uploaded photos & videos will live)
UPLOAD_LOCATION=/mnt/NAS/immich_library

# Database location on high-speed SSD / NVMe
# NOTE: Network shares (NFS/SMB) are strictly NOT supported for the database
DB_DATA_LOCATION=./postgres

# Local timezone (e.g. Asia/Kuala_Lumpur, America/New_York, UTC)
TZ=Asia/Kuala_Lumpur

# Immich release version (default: release)
IMMICH_VERSION=release

# PostgreSQL database credentials
# Generate a secure alphanumeric password (A-Z, a-z, 0-9 only)
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=replace_with_secure_random_alphanumeric_password

# Tailscale Auth Key (Reusable or pre-authorized authkey from https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-your-tailscale-key-here
